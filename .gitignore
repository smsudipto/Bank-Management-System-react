# Environment files and local overrides
.env
.env.*
!.env.example
*.local

# Dependencies
/vendor/
/node_modules/

# Frontend build output
/public/build/
/dist/
/dist-ssr/

# Laravel runtime files
/storage/app/*
!/storage/app/.gitignore
/storage/framework/*
!/storage/framework/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*
!/bootstrap/cache/.gitignore
/storage/*.key

# Local databases and test artifacts
/database/*.sqlite
/database/*.sqlite3
.phpunit.result.cache

# Logs and package-manager debug files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Local secrets and certificates
auth.json
*.pem
*.key
*.p12
*.pfx

# IDE and operating-system files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?